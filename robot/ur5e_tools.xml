<mujoco model="ur5e tools">
  <include file="../models/menagerie/m/universal_robots_ur5e/ur5e.xml"/>
  <compiler meshdir="../models/menagerie/m/universal_robots_ur5e/assets"/>
  <option timestep="0.002"/>
  <visual>
    <!-- 影の出ない柔らかい照明（作業場の照明を想定） -->
    <headlight diffuse="0.45 0.45 0.45" ambient="0.35 0.35 0.35" specular="0.05 0.05 0.05"/>
    <global offwidth="1280" offheight="960"/>
    <quality shadowsize="0"/>
  </visual>
  <asset>
    <texture type="2d" name="wood" builtin="flat" rgb1="0.78 0.76 0.72" width="64" height="64"/>
    <material name="table" texture="wood"/>
    <material name="metal" rgba="0.62 0.64 0.67 1" specular="0.6" shininess="0.6"/>
  </asset>
  <worldbody>
    <light pos="0 0.5 2" dir="0 0 -1" directional="true" diffuse="0.3 0.3 0.3" castshadow="false"/>
    <geom name="floor" size="2 2 0.05" type="plane" material="table"/>
    <!-- 置き場（箱）：黄色い枠。細長い物が入るように 20cm 角 -->
    <geom name="bin" type="box" pos="-0.32 0.45 0.001" size="0.10 0.10 0.001" rgba="0.95 0.8 0.1 1" contype="0" conaffinity="0"/>
    <!-- 箱の壁（高さ 3cm、厚さ 1cm）：細長い物がはみ出したり、押し出されたりしないように -->
    <geom name="wall_n" type="box" pos="-0.32 0.555 0.015" size="0.115 0.005 0.015" rgba="0.75 0.55 0.05 1"/>
    <geom name="wall_s" type="box" pos="-0.32 0.345 0.015" size="0.115 0.005 0.015" rgba="0.75 0.55 0.05 1"/>
    <geom name="wall_e" type="box" pos="-0.215 0.45 0.015" size="0.005 0.10 0.015" rgba="0.75 0.55 0.05 1"/>
    <geom name="wall_w" type="box" pos="-0.425 0.45 0.015" size="0.005 0.10 0.015" rgba="0.75 0.55 0.05 1"/>
    <camera name="top" pos="0 0.5 0.9" xyaxes="1 0 0 0 1 0" fovy="45"/>

    <!-- ドライバー：赤い持ち手（長さ 6cm）＋金属の軸（長さ 7cm）。x 方向に寝かせて置く -->
    <body name="screwdriver" pos="0.1 0.4 0.014"><freejoint/>
      <geom type="capsule" fromto="-0.065 0 0 -0.005 0 0" size="0.014" rgba="0.85 0.15 0.1 1" mass="0.05"/>
      <geom type="cylinder" fromto="-0.005 0 0 0.065 0 0" size="0.004" material="metal" mass="0.02"/>
    </body>
    <!-- ペン：青い軸（長さ 11cm）＋黒いキャップ -->
    <body name="pen" pos="0.2 0.55 0.006"><freejoint/>
      <geom type="capsule" fromto="-0.055 0 0 0.03 0 0" size="0.006" rgba="0.1 0.3 0.85 1" mass="0.01"/>
      <geom type="capsule" fromto="0.03 0 0 0.055 0 0" size="0.0065" rgba="0.05 0.05 0.06 1" mass="0.005"/>
    </body>
    <!-- ネジ 2 本：金属の頭（直径 1.8cm）＋軸（長さ 4cm） -->
    <body name="screw1" pos="0.0 0.6 0.009"><freejoint/>
      <geom type="cylinder" fromto="-0.022 0 0 -0.016 0 0" size="0.009" material="metal" mass="0.005"/>
      <geom type="cylinder" fromto="-0.016 0 0 0.022 0 0" size="0.004" material="metal" mass="0.005"/>
    </body>
    <body name="screw2" pos="0.25 0.35 0.009"><freejoint/>
      <geom type="cylinder" fromto="-0.022 0 0 -0.016 0 0" size="0.009" material="metal" mass="0.005"/>
      <geom type="cylinder" fromto="-0.016 0 0 0.022 0 0" size="0.004" material="metal" mass="0.005"/>
    </body>
  </worldbody>
</mujoco>
